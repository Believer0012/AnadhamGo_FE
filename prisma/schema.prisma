datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Booking {
  id                 String    @id
  slotKey            String?
  name               String
  email              String?
  phone              String
  campsiteId         String?
  package            String
  region             String?
  dates              String
  guests             Int
  groupType          String?
  roomType           String
  allocatedUnit      String?
  assignedTent       String?
  wristbandRange     String?
  addons             Json?
  total              Float
  paidAmount         Float?
  advancePaid        Float?
  balanceDue         Float?
  balanceCollected   Float?
  isBalancePaid      Boolean?  @default(false)
  settlementMethod   String?
  paymentMode        String?
  utrNumber          String?
  dietaryChoice      String?
  vegCount           Int?
  nonVegCount        Int?
  mealSummary        String?
  status             String    @default("Pending")
  source             String    @default("Website Booking Engine")
  notes              String?
  razorpayOrderId    String?   @unique
  paymentId          String?
  paidAt             DateTime?
  holdExpiresAt      BigInt?
  refundReason       String?
  pickupDropStatus   String?
  pickupTime         String?
  dropTime           String?
  checkedInCount     Int?
  shortCount         Int?
  marshalName        String?
  marshalNotes       String?
  convoyTime         String?
  emergencyPhone     String?
  discountCode       String?
  discountAmount     Float?
  attendanceRoster   Json?
  checkInAt          DateTime?
  lastNotifiedStatus String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([slotKey])
  @@index([createdAt])
  @@index([phone])
}

model WebhookEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
  payload     Json?

  @@index([event])
}

model CampOverride {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}
